generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id                  String    @id @default(cuid())
  phone               String?   @unique
  email               String?   @unique
  username            String?   @unique
  password            String?
  name                String?
  avatarUrl           String?
  role                Role      @default(USER)
  verified            Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  emailVerified       Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  profile             Profile?
  subscription        Subscription?
  auditLogs           AuditLog[]
  matchesAsA          Match[]   @relation("MatchUserA")
  matchesAsB          Match[]   @relation("MatchUserB")
  swipesFrom          Swipe[]   @relation("SwipesFrom")
  swipesTo            Swipe[]   @relation("SwipesTo")
  blocksMade          UserBlock[] @relation("BlocksMade")
  blocksReceived      UserBlock[] @relation("BlocksReceived")
  reportsMade         UserReport[] @relation("ReportsMade")
  reportsReceived     UserReport[] @relation("ReportsReceived")

  @@map("users")
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  bio                String?
  birthDate          DateTime?
  gender             String?
  interests          Json      @default("[]")
  photos             Json      @default("[]")
  latitude           Float?
  longitude          Float?
  location           Unsupported("geography(Point,4326)")?
  travelModeEnabled  Boolean   @default(false)
  travelLocation     Unsupported("geography(Point,4326)")?
  travelLatitude     Float?
  travelLongitude    Float?
  travelCity         String?
  city               String?
  country            String    @default("AE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([country])
  @@index([userId])
  @@map("profiles")
}

model Match {
  id        String      @id @default(cuid())
  userAId   String
  userBId   String
  userA     User        @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User        @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

model Swipe {
  id         String      @id @default(cuid())
  fromUserId String
  toUserId   String
  action     SwipeAction
  createdAt  DateTime    @default(now())
  fromUser   User        @relation("SwipesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User        @relation("SwipesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("swipes")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserReport {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  reporter   User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("user_reports")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum SwipeAction {
  LIKE
  PASS
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum SubscriptionTier {
  FREE
  GOLD
  PLATINUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}
