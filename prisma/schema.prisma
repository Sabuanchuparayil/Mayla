generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id                  String    @id @default(cuid())
  phone               String?   @unique
  email               String?   @unique
  username            String?   @unique
  password            String?
  name                String?
  avatarUrl           String?
  role                Role      @default(USER)
  verified            Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  emailVerified       Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  profile             Profile?
  preference          UserPreference?
  subscription        Subscription?
  auditLogs           AuditLog[]
  matchesAsA          Match[]   @relation("MatchUserA")
  matchesAsB          Match[]   @relation("MatchUserB")
  swipesFrom          Swipe[]   @relation("SwipesFrom")
  swipesTo            Swipe[]   @relation("SwipesTo")
  blocksMade          UserBlock[] @relation("BlocksMade")
  blocksReceived      UserBlock[] @relation("BlocksReceived")
  reportsMade         UserReport[] @relation("ReportsMade")
  reportsReceived     UserReport[] @relation("ReportsReceived")
  dateRequestsSent    DateRequest[] @relation("DateRequestsSent")
  dateRequestsReceived DateRequest[] @relation("DateRequestsReceived")
  pushSubscriptions   PushSubscription[]
  contactHashes       ContactHash[]
  giftsSent           VirtualGift[] @relation("GiftsSent")
  giftsReceived       VirtualGift[] @relation("GiftsReceived")
  eventRsvps          EventRsvp[]

  @@map("users")
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  bio                String?
  birthDate          DateTime?
  gender             String?
  nationality        String?
  languages          Json      @default("[]")
  education          String?
  jobTitle           String?
  industry           String?
  relationshipGoal   RelationshipGoal?
  lifestyle          Json      @default("[]")
  smoking            String?
  drinking           String?
  exercise           String?
  height             Int?
  personalityPrompts Json      @default("[]")
  interests          Json      @default("[]")
  photos             Json      @default("[]")
  latitude           Float?
  longitude          Float?
  location           Unsupported("geography(Point,4326)")?
  travelModeEnabled  Boolean   @default(false)
  travelLocation     Unsupported("geography(Point,4326)")?
  travelLatitude     Float?
  travelLongitude    Float?
  travelCity         String?
  city               String?
  country            String    @default("AE")
  availableDay       String?
  availableTime      String?
  availableExpiry    DateTime?
  profilePaused      Boolean   @default(false)
  incognitoMode      Boolean   @default(false)
  ladiesFirstMessaging Boolean @default(false)
  dreamDates         Json      @default("[]")
  openToDifferentCultures String?
  relocateWillingness String?
  lifestyleExpectations String?
  photoBlurUntilMatch Boolean  @default(false)
  blurredPhotoIndices Json      @default("[]")
  gentlemanScore     Int       @default(0)
  locale             String    @default("en")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([country])
  @@index([relationshipGoal])
  @@index([availableExpiry])
  @@index([userId])
  @@map("profiles")
}

model DateRequest {
  id           String            @id @default(cuid())
  fromUserId   String
  toUserId     String
  fromUser     User              @relation("DateRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User              @relation("DateRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  message      String?
  proposedDay  String?
  proposedTime String?
  status       DateRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@map("date_requests")
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  genderPref        Json     @default("[]")
  ageMin            Int?
  ageMax            Int?
  nationalities     Json     @default("[]")
  languages         Json     @default("[]")
  maxDistanceKm     Int      @default(100)
  relationshipGoals Json     @default("[]")
  dealbreakers      Json     @default("{}")
  hideFromNationalities Json @default("[]")
  hideFromCities    Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_preferences")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      Json
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

model ContactHash {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash   String
  createdAt   DateTime @default(now())

  @@unique([userId, phoneHash])
  @@index([phoneHash])
  @@map("contact_hashes")
}

model VirtualGift {
  id         String     @id @default(cuid())
  fromUserId String
  toUserId   String
  fromUser   User       @relation("GiftsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User       @relation("GiftsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  giftType   GiftType
  message    String?
  status     GiftStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  @@index([toUserId, status])
  @@index([fromUserId])
  @@map("virtual_gifts")
}

model CommunityEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  city        String
  country     String   @default("AE")
  category    String
  startsAt    DateTime
  maxAttendees Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rsvps       EventRsvp[]

  @@index([startsAt])
  @@index([city])
  @@map("community_events")
}

model EventRsvp {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  event     CommunityEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EventRsvpStatus  @default(GOING)
  createdAt DateTime         @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

model Match {
  id        String      @id @default(cuid())
  userAId   String
  userBId   String
  userA     User        @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User        @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

model Swipe {
  id         String      @id @default(cuid())
  fromUserId String
  toUserId   String
  action     SwipeAction
  createdAt  DateTime    @default(now())
  fromUser   User        @relation("SwipesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User        @relation("SwipesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("swipes")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserReport {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  reporter   User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("user_reports")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum RelationshipGoal {
  MARRIAGE
  LIFE_PARTNER
  RELATIONSHIP
  CASUAL_DATING
  COMPANIONSHIP
  SOCIAL_FUN
  RATHER_NOT_SAY
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum SwipeAction {
  LIKE
  PASS
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum SubscriptionTier {
  FREE
  GOLD
  PLATINUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum DateRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum GiftType {
  ROSE
  COFFEE
  DINNER_INVITE
  WEEKEND_PACKAGE
}

enum GiftStatus {
  PENDING
  SEEN
  DECLINED
}

enum EventRsvpStatus {
  GOING
  INTERESTED
}
