# Infrastructure CLI credentials (copy to .env.infra — never commit .env.infra)
#
#   cp .env.infra.example .env.infra
#   npm run infra:setup-cli
#   npm run infra:verify

# Hetzner Cloud — token from https://console.hetzner.cloud → Security → API Tokens
HCLOUD_TOKEN=
HCLOUD_CONTEXT=mayla
HCLOUD_SERVER_ID=132875183
HETZNER_SERVER_IP=204.168.235.151

# Coolify — UI: Settings → API → enable API; create Personal Access Token
# Quote tokens that contain | characters
COOLIFY_CONTEXT=mayla-production
COOLIFY_HOST=http://204.168.235.151:8000
COOLIFY_TOKEN=""

# SSH fallback for server checks (optional)
MAYLA_SSH_HOST=204.168.235.151
MAYLA_SSH_USER=root
