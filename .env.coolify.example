# ─── Stripe (production) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_GOLD=price_...
# STRIPE_PRICE_PLATINUM=price_...

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@mayla.app
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...

# ─── Deploy steps ────────────────────────────────────────────────────────────
# 1. npx prisma migrate deploy  (apply pending migrations on PostGIS)
# 2. Build Docker image via Coolify (Dockerfile multi-stage)
# 3. Set all env vars above in Coolify
# 4. Ensure app joins `coolify` network for internal DB hostnames
# 5. Verify Cloudflare Tunnel routes to app container
# 6. Test Stripe webhook: stripe listen --forward-to https://YOUR_DOMAIN/api/webhooks/stripe

# CLI management (local Mac):
#   cp .env.infra.example .env.infra
#   npm run infra:setup-cli
#   npm run infra:verify
