# Local development — copy to .env when developing on your Mac:
#   cp .env.local.example .env
#
# Setup (no Docker):
#   npm run setup:local
#   npm run dev
#
# If dev says "Another next dev server is already running":
#   kill $(lsof -t -i:3000)

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000
COOKIE_SECURE=false
OTP_HARDCODED=true
MOCK_VERIFICATION=true
MOCK_UPLOAD=true
MOCK_STRIPE=true

DATABASE_URL="postgresql://mayla:mayla_secret@localhost:5432/mayla_db?schema=public"
# Local Redis (Homebrew) usually has no password — use redis://localhost:6379
REDIS_URL="redis://localhost:6379"
# MongoDB optional for chat — install with: brew install mongodb-community
MONGODB_URL="mongodb://localhost:27017/mayla_db"

JWT_SECRET=change_me_to_a_long_random_string_min_32_chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_min_32!
JWT_REFRESH_EXPIRES_IN=30d
