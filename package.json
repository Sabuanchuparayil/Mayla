    "setup:services": "bash scripts/setup-services.sh",
    "infra:setup-cli": "bash scripts/infra/setup-cli.sh",
    "infra:verify": "bash scripts/infra/verify.sh",
    "infra:fix-prod-env": "bash scripts/infra/fix-prod-env.sh",
