# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mayla
NEXT_PUBLIC_WS_URL=http://localhost:3000
COOKIE_SECURE=false
OTP_HARDCODED=true
MOCK_VERIFICATION=true

# ─── PostgreSQL / PostGIS ───────────────────────────────────────────────────────
POSTGRES_USER=mayla
POSTGRES_PASSWORD=mayla_secret
POSTGRES_DB=mayla_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://mayla:mayla_secret@localhost:5432/mayla_db?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL="redis://:redis_secret@localhost:6379"

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_USER=mayla
MONGO_PASSWORD=mongo_secret
MONGO_DB=mayla_db
MONGO_HOST=localhost
MONGO_PORT=27017
MONGODB_URL="mongodb://mayla:mongo_secret@localhost:27017/mayla_db?authSource=admin"
MONGODB_URI="mongodb://mayla:mongo_secret@localhost:27017/mayla_db?authSource=admin"

# ─── Auth (JWT via jose) ─────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_min_32!
JWT_REFRESH_EXPIRES_IN=30d

# ─── AWS (Bahrain region for Middle East) ────────────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REKOGNITION_COLLECTION_ID=your-rekognition-collection

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_GOLD=price_gold_placeholder
STRIPE_PRICE_PLATINUM=price_platinum_placeholder

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@mayla.app

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mayla.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
